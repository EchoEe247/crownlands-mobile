{
  "name": "crownlands-mobile",
  "version": "0.9.0",
  "private": true,
  "description": "Mobile-first 3D king simulation for Android/Pixel-class devices.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/game.js --bundle --minify --format=esm --target=chrome120 --outfile=dist/game.fast.js",
    "check": "node --check src/game.js && node --check dist/game.fast.js",
    "serve": "python -m http.server 5205 --bind 127.0.0.1"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}
